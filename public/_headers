# mathduel.games — 响应头
# Cache-Control: max-age=14400 (4h) 而非 31536000 (1y)，原因：
# 1. 历史上缺 404.html 时，CF 把缺失资源回落到站点根 (200 + HTML)，
#    而 /fonts/* /assets/* 这条 immutable 1y 规则把"脏 HTML"固化了 1 年
#    （缓存投毒 B-008）；缩短到 4h 让边缘误缓存能自动过期
# 2. 实际生产中，所有静态资源文件名都带 hash，构建切换瞬间新文件名 ≠ 老文件名，
#    immutable 价值不大；4h revalidate 足够压住常规流量尖峰
# must-revalidate：客户端拿到过期响应时必须先回源验证，比 no-cache 多一层 CDN 缓存
# CSP 修复说明：connect-src 已包含 https://mathduel.games 与 wss://mathduel.games，
#   但 production CSP 没放行 static.cloudflareinsights.com（CSP 拦掉 RUM 数据，见 B-003）

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://mathduel.games https://static.cloudflareinsights.com wss://mathduel.games; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/fonts/*
  Cache-Control: public, max-age=14400, must-revalidate

/assets/*
  Cache-Control: public, max-age=14400, must-revalidate
