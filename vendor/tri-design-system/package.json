{
  "name": "@tri-sites/design-system",
  "version": "1.0.0",
  "description": "三站统一设计系统（tokens / base / components / i18n / 头部 / 抽屉 / toast / 每日挑战 / 分享卡）",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./i18n": "./src/i18n/index.ts",
    "./lib/*": "./src/lib/*"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ]
}
