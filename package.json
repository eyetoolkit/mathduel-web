{
  "name": "mathduel-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MathDuel 独立前端（Vite + TS + Tailwind + 设计系统）",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20.0.0 <23",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-legacy.mjs",
    "build:beta": "VITE_SHOW_BETA=1 tsc --noEmit && VITE_SHOW_BETA=1 vite build && VITE_SHOW_BETA=1 node scripts/copy-legacy.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tri-sites/design-system": "file:./vendor/tri-design-system"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
